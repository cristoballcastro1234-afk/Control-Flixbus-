{
  "name": "flixbus-turnos",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "db:create": "wrangler d1 create flixbus-turnos-db",
    "db:migrate:local": "wrangler d1 migrations apply flixbus-turnos-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply flixbus-turnos-db --remote",
    "db:migrate:v2:existing": "wrangler d1 execute flixbus-turnos-db --remote --file=./migrations/0005_control_v2.sql",
    "typecheck": "tsc --noEmit",
    "deploy:limpieza": "wrangler deploy --config wrangler.limpieza.toml",
    "test": "node --test tests/control.test.cjs tests/gps.test.mjs tests/gps-piloto.test.mjs",
    "deploy:realtime": "wrangler deploy --config wrangler.realtime.toml",
    "deploy:gps-piloto": "wrangler deploy --config wrangler.gps-piloto.toml"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
