{
  "name": "flixbus-turnos",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "db:create": "wrangler d1 create flixbus-turnos-db",
    "db:migrate:local": "wrangler d1 execute flixbus-turnos-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute flixbus-turnos-db --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
